}item(FEAT_OBJECTS, hq_poor_cc, 100) {
    property {
        class:                  "HDQ0";
        classname:              string(STR_HDQ0);
        name:                   string(STR_NAME_HQ_POOR_CC);
        climates_available:     ALL_CLIMATES;
        size:                   [2,2];
        build_cost_multiplier:  2;
        remove_cost_multiplier: 8;
        introduction_date:      0;
        end_of_life_date:       0xFFFFFFFF;
        object_flags:           bitmask(OBJ_FLAG_REMOVE_IS_INCOME, OBJ_FLAG_ALLOW_BRIDGE);
        height:                 2;
        num_views:              1;
        count_per_map256:       0;
    }
    graphics {
    
        default: graphics_hq(2603, colour);
        purchase: purchase_hq_cc(2603);
    
        autoslope: return CB_RESULT_AUTOSLOPE;
    }
}
