grf {
  grfid:                  "WFY\48";
  name:                   string(STR_GRF_NAME);
  desc:                   string(STR_GRF_DESCRIPTION);
  url:                    string(STR_GRF_URL);
  version:                94;
  min_compatible_version: 0;
}


spritelayout sprite_hq_n {
    ground {
        sprite: GROUNDSPRITE_NORMAL;
    }
	building {
        sprite: LOAD_TEMP(0) + 0;
        recolour_mode: RECOLOUR_REMAP;
        palette: LOAD_TEMP(1);
	}
}

spritelayout sprite_hq_e {
    ground {
        sprite: GROUNDSPRITE_NORMAL;
    }
	building {
        sprite: LOAD_TEMP(0) + 1;
        recolour_mode: RECOLOUR_REMAP;
        palette: LOAD_TEMP(1);
	}
}

spritelayout sprite_hq_s {
    ground {
        sprite: GROUNDSPRITE_NORMAL;
    }
	building {
