        palette: LOAD_TEMP(1);
	}
}

spritelayout sprite_hq_w {
    ground {
        sprite: GROUNDSPRITE_NORMAL;
    }
	building {
        sprite: LOAD_TEMP(0) + 2;
        recolour_mode: RECOLOUR_REMAP;
        palette: LOAD_TEMP(1);
	}
}

spritelayout sprite_hq_purchase {
	building {
        sprite: LOAD_TEMP(0) + 0;
        recolour_mode: RECOLOUR_REMAP;
        palette: LOAD_TEMP(1);
        xoffset: -8;
        yoffset: -8;
	}
	childsprite {
        sprite: LOAD_TEMP(0) + 3;
        recolour_mode: RECOLOUR_REMAP;
        palette: LOAD_TEMP(1);
        xoffset: 32;
        yoffset: 32;
    }
	childsprite {
        sprite: LOAD_TEMP(0) + 2;
        recolour_mode: RECOLOUR_REMAP;
        palette: LOAD_TEMP(1);
        xoffset: 0;
        yoffset: 16;
    }
	childsprite {
        sprite: LOAD_TEMP(0) + 1;
        recolour_mode: RECOLOUR_REMAP;
        palette: LOAD_TEMP(1);
        xoffset: 64;
        yoffset: 16;
    }
}

switch (FEAT_OBJECTS, SELF, graphics_hq_tiles, relative_y + (relative_x * 2)) {
    0: sprite_hq_n;
    1: sprite_hq_e;
    2: sprite_hq_w;
    3: sprite_hq_s;
}

switch (FEAT_OBJECTS, SELF, graphics_hq, sprite_index, desired_colour, [STORE_TEMP(sprite_index, 0), STORE_TEMP(palette_1cc(desired_colour), 1)]) {
    graphics_hq_tiles;
}

switch (FEAT_OBJECTS, SELF, purchase_hq, sprite_index, desired_colour, [STORE_TEMP(sprite_index, 0), STORE_TEMP(palette_1cc(desired_colour), 1)]) {
    sprite_hq_purchase;
}

switch (FEAT_OBJECTS, SELF, purchase_hq_cc, sprite_index, [STORE_TEMP(sprite_index, 0), STORE_TEMP(PALETTE_USE_DEFAULT, 1)]) {
    sprite_hq_purchase;
}


